# Databases and generated indexes are private by default. Only explicitly
# synthetic fixtures under tests/fixtures/synthetic may be committed.
*.sqlite
*.sqlite3
*.db
!tests/fixtures/synthetic/**/*.sqlite
!tests/fixtures/synthetic/**/*.sqlite3
!tests/fixtures/synthetic/**/*.db

